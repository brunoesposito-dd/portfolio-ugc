---
// Grade de vídeos verticais.
import Cabecalho from './Cabecalho.astro';
import VideoCard from './VideoCard.astro';
import { c, videosDaGrade } from '../lib/site';

---

<section class="secao recuo" id="videos" aria-labelledby="videos-titulo">
  <Cabecalho rotulo="Portfólio" titulo={c.videos!.titulo} id="videos-titulo" />
  <ul class="grade">
    {
      videosDaGrade.map((v) => (
        <li>
          <VideoCard video={v} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .grade {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  @media (min-width: 1024px) {
    .grade {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
