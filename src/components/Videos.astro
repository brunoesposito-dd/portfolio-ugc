---
// Grade de vídeos verticais.
import Cabecalho from './Cabecalho.astro';
import VideoCard from './VideoCard.astro';
import { c, videosDaGrade } from '../lib/site';

const { numero } = Astro.props as { numero: number };
---

<section class="secao recuo" id="videos" aria-labelledby="videos-titulo">
  <Cabecalho numero={numero} titulo={c.videos!.titulo} id="videos-titulo" />
  <ul class="grade">
    {
      videosDaGrade.map((v) => (
        <li>
          <VideoCard video={v} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1rem;
  }
  /* Colunas pares um pouco mais baixas: ritmo de página de revista. */
  @media (min-width: 760px) {
    .grade {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4.5rem 1.5rem;
      padding-bottom: 2.5rem;
    }
    .grade li:nth-child(3n + 2) {
      translate: 0 2.5rem;
    }
  }
  @media (min-width: 1100px) {
    .grade {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .grade li:nth-child(3n + 2) {
      translate: none;
    }
    .grade li:nth-child(even) {
      translate: 0 2.5rem;
    }
  }
</style>
