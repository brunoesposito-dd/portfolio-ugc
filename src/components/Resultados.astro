---
// Resultados: números, prints e depoimentos. Cada parte some se a lista estiver vazia.
import { Image } from 'astro:assets';
import Cabecalho from './Cabecalho.astro';
import { c } from '../lib/site';

const { numero } = Astro.props as { numero: number };
const { titulo, numeros, prints, depoimentos } = c.resultados!;
---

<section class="secao recuo" id="resultados" aria-labelledby="resultados-titulo">
  <Cabecalho numero={numero} titulo={titulo} id="resultados-titulo" />
  {
    numeros.length > 0 && (
      <dl class="numeros">
        {numeros.map((n) => (
          <div>
            <dt>{n.legenda}</dt>
            <dd>{n.valor}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    prints.length > 0 && (
      <div class="prints">
        {prints.map((p) => (
          <figure>
            <Image src={p.imagem} alt={p.legenda} widths={[320, 480, 720]} sizes="(min-width: 760px) 30vw, 46vw" />
            <figcaption>{p.legenda}</figcaption>
          </figure>
        ))}
      </div>
    )
  }
  {
    depoimentos.length > 0 && (
      <div class="desloca depoimentos">
        {depoimentos.map((d) => (
          <figure>
            <blockquote>
              <p>{d.texto}</p>
            </blockquote>
            <figcaption>
              {d.autor}
              {d.marca && <span>, {d.marca}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    )
  }
</section>

<style>
  .numeros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2rem 3rem;
  }
  .numeros div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--linha);
  }
  dd {
    font-family: var(--f-titulo);
    font-weight: var(--peso-titulo);
    font-size: calc(clamp(3.5rem, 13vw, 6.5rem) * var(--escala));
    letter-spacing: var(--espaco-titulo);
    line-height: 0.9;
    color: var(--destaque);
  }
  dt {
    max-width: 18rem;
    color: var(--suave);
  }
  .prints {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 14rem), 1fr));
    gap: 1.5rem 1rem;
    margin-top: clamp(3rem, 8vw, 5rem);
  }
  .prints :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--raio);
    box-shadow: 0 0 0 1px var(--linha);
  }
  .prints figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--suave);
  }
  .depoimentos {
    display: grid;
    gap: 3rem;
    margin-top: clamp(3rem, 8vw, 5rem);
  }
  blockquote p {
    font-family: var(--f-titulo);
    font-style: var(--italico);
    font-size: calc(clamp(1.6rem, 5vw, 2.6rem) * var(--escala));
    line-height: 1.15;
    text-wrap: pretty;
  }
  blockquote p::before {
    content: '“';
    color: var(--destaque);
  }
  blockquote p::after {
    content: '”';
    color: var(--destaque);
  }
  .depoimentos figcaption {
    margin-top: 1rem;
    font-weight: 600;
  }
  .depoimentos figcaption::before {
    content: '— ' / '';
  }
  .depoimentos figcaption span {
    font-weight: 400;
  }
</style>
