---
// Marcas com quem já trabalhou: logo (se tiver) ou só o nome.
import { Image } from 'astro:assets';
import Cabecalho from './Cabecalho.astro';
import { c } from '../lib/site';

const { numero } = Astro.props as { numero: number };
const marcas = c.marcas!;
---

<section class="secao recuo" id="marcas" aria-labelledby="marcas-titulo">
  <Cabecalho numero={numero} titulo={marcas.titulo} id="marcas-titulo" />
  <ul class="desloca lista">
    {
      marcas.lista.map((m) => (
        <li>{m.logo ? <Image src={m.logo} alt={m.nome} height={48} densities={[1, 2]} /> : m.nome}</li>
      ))
    }
  </ul>
</section>

<style>
  .lista {
    font-family: var(--f-titulo);
    font-weight: var(--peso-titulo);
    font-size: calc(clamp(1.5rem, 4.5vw, 2.5rem) * var(--escala));
    letter-spacing: var(--espaco-titulo);
    text-transform: var(--caixa-titulo);
    line-height: 1.15;
  }
  li {
    display: inline;
  }
  li:not(:last-child)::after {
    content: ' · ' / '';
    color: var(--destaque);
    white-space: pre;
  }
  li :global(img) {
    display: inline-block;
    width: auto;
    height: 3rem;
    margin-block: 0.3rem;
    vertical-align: middle;
  }
</style>
