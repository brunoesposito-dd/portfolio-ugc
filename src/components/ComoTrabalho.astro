---
// Como eu trabalho: ficha técnica (prazo, incluso, direitos de uso) e formatos de entrega.
import Cabecalho from './Cabecalho.astro';
import { c } from '../lib/site';

const { numero } = Astro.props as { numero: number };
const t = c.comoTrabalho!;
---

<section class="secao recuo" id="como-trabalho" aria-labelledby="como-trabalho-titulo">
  <Cabecalho numero={numero} titulo={t.titulo} id="como-trabalho-titulo" />
  <div class="desloca">
    {
      (t.prazo || t.incluso.length > 0 || t.direitosDeUso) && (
        <dl class="ficha">
          {t.prazo && (
            <div>
              <dt class="kicker">Prazo</dt>
              <dd>{t.prazo}</dd>
            </div>
          )}
          {t.incluso.length > 0 && (
            <div>
              <dt class="kicker">O que está incluso</dt>
              <dd>
                <ul class="incluso">{t.incluso.map((item) => <li>{item}</li>)}</ul>
              </dd>
            </div>
          )}
          {t.direitosDeUso && (
            <div>
              <dt class="kicker">Direitos de uso</dt>
              <dd>{t.direitosDeUso}</dd>
            </div>
          )}
        </dl>
      )
    }
    {
      t.pacotes.length > 0 && (
        <>
          <h3 class="kicker subtitulo">Formatos de entrega</h3>
          <ul class="pacotes">
            {t.pacotes.map((p) => (
              <li>
                <h4>{p.nome}</h4>
                {p.descricao && <p>{p.descricao}</p>}
                {t.mostrarPrecos && p.preco && <p class="preco">{p.preco}</p>}
              </li>
            ))}
          </ul>
        </>
      )
    }
    {t.observacao && <p class="observacao">{t.observacao}</p>}
  </div>
</section>

<style>
  .ficha > div {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--linha);
  }
  .ficha > div:last-child {
    border-bottom: 1px solid var(--linha);
  }
  dd {
    font-size: 1.05rem;
  }
  .incluso li {
    position: relative;
    padding-left: 1.3rem;
  }
  .incluso li + li {
    margin-top: 0.35rem;
  }
  .incluso li::before {
    content: '+' / '';
    position: absolute;
    left: 0;
    color: var(--destaque);
    font-weight: 600;
  }
  .subtitulo {
    margin: clamp(3rem, 8vw, 4.5rem) 0 1.25rem;
    font-family: var(--f-corpo);
    letter-spacing: 0.14em;
  }
  .pacotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .pacotes li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.5rem;
    border-radius: var(--raio);
    background: var(--superficie);
  }
  h4 {
    margin: 0;
    font-family: var(--f-titulo);
    font-weight: var(--peso-titulo);
    font-size: calc(1.35rem * var(--escala));
    letter-spacing: var(--espaco-titulo);
    text-transform: var(--caixa-titulo);
    line-height: 1.05;
  }
  .pacotes p {
    color: var(--suave);
  }
  .pacotes .preco {
    margin-top: 0.5rem;
    color: var(--texto);
    font-weight: 600;
    font-size: 1.15rem;
  }
  .observacao {
    max-width: 34rem;
    margin-top: 2rem;
    color: var(--suave);
  }
  @media (min-width: 640px) {
    .ficha > div {
      grid-template-columns: 13rem 1fr;
      column-gap: 2rem;
    }
    .ficha dt {
      padding-top: 0.3rem;
    }
  }
</style>
